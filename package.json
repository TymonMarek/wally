{
  "name": "@tymonmarek/wally",
  "version": "0.5.2",
  "description": "A minimal plugin template for semantic-release.",
  "homepage": "https://github.com/TymonMarek/wally",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TymonMarek/wally.git"
  },
  "author": "Tymon Marek <tymon.marek@icloud.com>",
  "bugs": {
    "email": "tymon.marek@icloud.com",
    "url": "https://github.com/TymonMarek/wally/issues"
  },
  "license": "MIT",
  "scripts": {
    "minify": "npx jiti esbuild.config.mts",
    "build": "tsc --project tsconfig.build.json",
    "lint:check": "eslint --config eslint.config.mts .",
    "lint": "eslint --fix --config eslint.config.mts .",
    "format:check": "prettier --check --config prettier.config.mts .",
    "format": "prettier --write --config prettier.config.mts .",
    "commitlint": "commitlint --config commitlint.config.mts --last --verbose",
    "test": "jest",
    "verify": "npm run lint:check && npm run format:check && npm run test",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "audit": "corepack npm audit signatures",
    "prepublishOnly": "npm run build && npm run minify",
    "release": "semantic-release"
  },
  "lint-staged": {
    "!(*.d).ts": [
      "eslint --fix --config eslint.config.mts",
      "prettier --write --config prettier.config.mts"
    ],
    "*.md": [
      "eslint --fix --config eslint.config.mts"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@jest/globals": "^30.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node20": "^20.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/semantic-release__error": "^3.0.3",
    "@types/signale": "^1.4.7",
    "corepack": "^0.34.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "aggregate-error": "^5.0.0",
    "execa": "^9.6.1",
    "semantic-release": "^25.0.3"
  }
}
