{
  "name": "@tymonmarek/wally",
  "version": "0.1.0",
  "description": "A minimal plugin template for semantic-release.",
  "main": "build/index.js",
  "repository": "https://github.com/TymonMarek/wally",
  "author": "Tymon Marek <tymon.marek@icloud.com>",
  "bugs": {
    "email": "tymon.marek@icloud.com",
    "url": "https://github.com/TymonMarek/wally/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "test": "jest",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts}": [
      "npm run lint",
      "npm run format",
      "npm run build",
      "npm run test"
    ],
    "*.{json,md}": [
      "npm run lint",
      "npm run format"
    ]
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "docs/CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@jest/globals": "^30.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node20": "^20.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/semantic-release__error": "^3.0.3",
    "@types/signale": "^1.4.7",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "semantic-release": "^25.0.3"
  }
}
